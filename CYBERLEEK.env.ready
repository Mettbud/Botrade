# =============================================================================
# CYBERLEEK bot - gotowy profil PAPER / short-term spot
# Skopiuj CAŁĄ zawartość do .env, a następnie samodzielnie uzupełnij dwa
# puste sekrety poniżej. Ten plik nigdy nie zawiera prawdziwych kluczy.
# =============================================================================

# --- Sekrety uzupełniane wyłącznie przez właściciela -------------------------
WALLET_PRIVATE_KEY=
JUPITER_API_KEY=

# --- Solana / Jupiter ---------------------------------------------------------
RPC_URL=https://api.mainnet-beta.solana.com
RPC_WS_URL=
JUPITER_BASE_URL=https://lite-api.jup.ag
JUPITER_MIN_REQUEST_INTERVAL_MS=2100
JUPITER_429_MAX_RETRIES=2
JUPITER_429_FALLBACK_BACKOFF_MS=5000

# --- Token -------------------------------------------------------------------
TARGET_TOKEN_MINT=ApZuxdpzMrbEYTGEzeY9afh5pj9d6qPRJCTgQYiipbKg
TARGET_TOKEN_SYMBOL=CYBERLEEK
SOL_MINT=So11111111111111111111111111111111111111112
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# --- Tryb i limity pieniędzy -------------------------------------------------
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false
MAX_TRADE_USD=50
MIN_SOL_RESERVE=0.05
PAPER_BALANCE_USD=1000
PAPER_POSITION_SIZE_PERCENT=10

# --- Poślizg / impact / spread -----------------------------------------------
MAX_SLIPPAGE_BPS=150
MAX_PRICE_IMPACT_BPS=300
MAX_SPREAD_BPS=50
MAX_SPREAD_HIGH_GAIN_BPS=100
MAX_SPREAD_HIGH_GAIN_THRESHOLD_PERCENT=10

# --- Monitoring ceny ---------------------------------------------------------
PRICE_POLL_INTERVAL_MS=4000
PRICE_REFERENCE_SOL_AMOUNT=0.01
SOL_PRICE_REFRESH_MS=10000

# --- Momentum ----------------------------------------------------------------
MOMENTUM_UP_10S_PCT=5
MOMENTUM_UP_30S_PCT=10
MOMENTUM_DOWN_10S_PCT=5
MOMENTUM_DOWN_30S_PCT=10
PRICE_IMPACT_SPIKE_BPS=200

# --- Take profit: liniowo od entry -------------------------------------------
# +5% -> 20% pozycji startowej, +10% -> kolejne 20%, +15% -> kolejne 20%.
TAKE_PROFIT_LEVELS=20:20,40:20,70:100
TAKE_PROFIT_MODE=cascade
CASCADE_TAKE_PROFIT_PERCENT=5
CASCADE_TAKE_PROFIT_SELL_PERCENT=20

# Po trzeciej wypłacie (łącznie 60% startu) pozostała regularna część ma
# profit floor entry +8%. Trigger wymaga potwierdzenia przez 4 sekundy.
CASCADE_PROFIT_LOCK_ENABLED=true
CASCADE_PROFIT_LOCK_AFTER_TRANCHES=3
CASCADE_PROFIT_LOCK_GAIN_PERCENT=8
CASCADE_PROFIT_LOCK_CONFIRMATION_ENABLED=true
CASCADE_PROFIT_LOCK_CONFIRMATION_MS=4000

# --- Stop loss / trailing stop ------------------------------------------------
# Trailing uzbraja się dopiero po +5%. Przed tym poziomem pozycję chroni
# hard stop -15%, więc zwykłe wahanie zaraz po zakupie nie uruchamia trailingu.
STOP_LOSS_PERCENT=15
TRAILING_STOP_PERCENT=12
TRAILING_STOP_ACTIVATION_PERCENT=5
TRAILING_STOP_LEVELS=
STOP_CONFIRMATION_ENABLED=true
STOP_CONFIRMATION_MS=4000

# --- Zwykły auto-buy z adaptacją do piku i zmienności ------------------------
AUTO_BUY_ENABLED=true
AUTO_BUY_DIP_PERCENT=2
AUTO_BUY_DIP_LOOKBACK_MS=60000
AUTO_BUY_REBOUND_PERCENT=1
AUTO_BUY_REBOUND_CONFIRMATION_MS=8000
AUTO_BUY_REBOUND_TIMEOUT_MS=30000
AUTO_BUY_PEAK_PROTECTION_ENABLED=true
AUTO_BUY_PEAK_LOOKBACK_MS=300000
AUTO_BUY_PEAK_RUNUP_PERCENT=10
AUTO_BUY_PEAK_DIP_PERCENT=6
AUTO_BUY_VOLATILITY_PROTECTION_ENABLED=true
AUTO_BUY_VOLATILITY_LOOKBACK_MS=60000
AUTO_BUY_VOLATILITY_MULTIPLIER=1.5
AUTO_BUY_VOLATILITY_MAX_DIP_PERCENT=8
AUTO_BUY_ALLOW_AVERAGING=false
AUTO_BUY_MIN_GAP_MS=60000
AUTO_BUY_REQUIRE_BELOW_LAST_SELL=true

# --- Recovery-buy: jedno dokupienie po potwierdzonym odbiciu ----------------
RECOVERY_BUY_ENABLED=true
RECOVERY_BUY_DROP_PERCENT=8
RECOVERY_BUY_LOOKBACK_MS=300000
RECOVERY_BUY_REBOUND_PERCENT=3
RECOVERY_BUY_CONFIRMATION_MS=8000
RECOVERY_BUY_TIMEOUT_MS=60000
RECOVERY_BUY_PORTFOLIO_PERCENT=5
RECOVERY_BUY_MAX_ADDS_PER_POSITION=1
RECOVERY_BUY_MAX_SPREAD_BPS=100
RECOVERY_BUY_MIN_LOSS_PERCENT=4
RECOVERY_BUY_MAX_LOSS_PERCENT=12

# --- Izolowany crash-buy ------------------------------------------------------
# Tryb raydium_direct reaguje na ONCHAIN_JUMP_WINDOW_MS=3000 i omija kolejkę
# Jupitera. CRASH_BUY_WINDOW_MS=12000 pozostaje dla trybu jupiter. Exit
# sprzedaje wyłącznie zapisany crash-lot.
# PAPER używa 50% salda bez limitu dolarowego; limit $50 obowiązuje tylko LIVE.
CRASH_BUY_ENABLED=true
CRASH_BUY_EXECUTION_MODE=raydium_direct
CRASH_BUY_DROP_PERCENT=20
CRASH_BUY_WINDOW_MS=12000
CRASH_BUY_MAX_USD=50
CRASH_BUY_PORTFOLIO_PERCENT=50
CRASH_BUY_REBOUND_TOLERANCE_PERCENT=3
CRASH_BUY_MAX_SPREAD_BPS=500
CRASH_BUY_STATUS_HOLD_MS=60000
CRASH_BUY_RAYDIUM_POOL_ID=G8kgi7aUpeX8EVR8VMkrth9SKEv5BietWC33UjAiiMGh
CRASH_BUY_RAYDIUM_WATCH_LABEL=raydium1
RAYDIUM_SWAP_BASE_URL=https://transaction-v1.raydium.io
RAYDIUM_PRIORITY_FEE_MICROLAMPORTS=50000

# --- Szybki trigger on-chain -------------------------------------------------
ONCHAIN_WATCH_ENABLED=true
ONCHAIN_JUMP_PERCENT=2
ONCHAIN_JUMP_WINDOW_MS=3000
WATCH_POOLS=raydium1:4cQ4QmL4h85RyEVzb1bWsmvd25zMdgkAKipVyKqpKs5Y:6iZNEKMsSDHG42UpDXgGd2FRNZosEDe7RbLwjNPAtaKU

# --- Wykonanie transakcji ----------------------------------------------------
PRIORITY_LEVEL=medium
PRIORITY_MAX_LAMPORTS=2000000

# --- Baza / logi / panel ------------------------------------------------------
DB_PATH=./data/cyberleek.sqlite
LOG_LEVEL=info
LOG_FILE=./data/bot.log
DASHBOARD_REFRESH_MS=1000
