# =============================================================================
# CYBERLEEK bot - environment configuration template
# Copy this file to ".env" and fill in your own values.
# NEVER commit ".env" - it is already listed in .gitignore.
# =============================================================================

# --- Wallet -------------------------------------------------------------
# Base58-encoded secret key of a DEDICATED hot wallet created only for this
# bot. Do NOT use your main Phantom wallet. Never share this value.
WALLET_PRIVATE_KEY=

# --- Solana RPC -----------------------------------------------------------
RPC_URL=https://api.mainnet-beta.solana.com
# Optional websocket URL. If omitted it is derived from RPC_URL.
RPC_WS_URL=

# --- Jupiter API ------------------------------------------------------------
# Free tier is https://lite-api.jup.ag - works without a key but is rate
# limited. Get a free key at https://portal.jup.ag and it will switch to
# https://api.jup.ag automatically.
JUPITER_API_KEY=
JUPITER_BASE_URL=https://lite-api.jup.ag

# --- Target token -------------------------------------------------------------
# The bot trades exactly one token against SOL. Today this is CYBERLEEK, but
# both fields are plain config: point them at any other SPL token mint later
# and the bot trades that instead. Decimals are read from the chain, not
# hardcoded, so nothing else needs to change.
TARGET_TOKEN_MINT=ApZuxdpzMrbEYTGEzeY9afh5pj9d6qPRJCTgQYiipbKg
TARGET_TOKEN_SYMBOL=CYBERLEEK

# --- Reference mints ----------------------------------------------------------
SOL_MINT=So11111111111111111111111111111111111111112
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# --- Trading mode safety switches -------------------------------------------
# Both of these must be changed on purpose before any real money moves.
# TRADING_MODE=paper|live
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false

# --- Hard money-safety limits ------------------------------------------------
# Maximum USD size of a single trade (paper or live).
MAX_TRADE_USD=1
# SOL that must always stay untouched in the wallet (fees, rent, future sells).
MIN_SOL_RESERVE=0.05
# Starting simulated balance for paper trading.
PAPER_BALANCE_USD=100
# Auto-buy sizing in PAPER mode ONLY: percent of the current paper balance
# to spend per auto-buy (so a $100 pool actually flows/compounds instead
# of always trading the same $1). Never applies to LIVE - live auto-buys
# always use MAX_TRADE_USD no matter what this is set to.
PAPER_POSITION_SIZE_PERCENT=5

# --- Slippage / price impact guards ------------------------------------------
MAX_SLIPPAGE_BPS=150
MAX_PRICE_IMPACT_BPS=300

# --- Price monitoring ---------------------------------------------------------
# How often to refresh the executable buy/sell quote (ms). Kept >=1000 to
# avoid hammering the public Jupiter API.
PRICE_POLL_INTERVAL_MS=2000
# Reference SOL amount used to sample an executable buy quote.
PRICE_REFERENCE_SOL_AMOUNT=0.01
# How often to refresh the SOL/USD reference price (ms).
SOL_PRICE_REFRESH_MS=10000

# --- Momentum / dump detection thresholds (percent) --------------------------
MOMENTUM_UP_10S_PCT=5
MOMENTUM_UP_30S_PCT=10
MOMENTUM_DOWN_10S_PCT=5
MOMENTUM_DOWN_30S_PCT=10
# Executable price impact (bps) on the reference quote that is considered a
# sudden liquidity/impact spike worth flagging.
PRICE_IMPACT_SPIKE_BPS=200

# --- Strategy: take profit ----------------------------------------------------
# Comma separated list of "gainPercent:sellPercentOfRemainingPosition".
# Only used when TAKE_PROFIT_MODE=entry (default).
TAKE_PROFIT_LEVELS=20:20,40:20,70:100
# "entry" (default): TAKE_PROFIT_LEVELS above is a fixed ladder measured
# from the original entry price - once you clear +70% nothing further ever
# fires again. "cascade": ignores TAKE_PROFIT_LEVELS and instead repeats one
# rule forever - "+CASCADE_TAKE_PROFIT_PERCENT from the last tranche's sell
# price (or entry, before the first one) -> sell CASCADE_TAKE_PROFIT_SELL_PERCENT
# of whatever's currently left" - so realizing gains keeps compounding with
# an ongoing trend instead of stopping after 3 fixed levels. The position
# never fully closes through this alone (each tranche only sells a % of
# what's left, so a shrinking remainder always stays open) - stop-loss/
# trailing-stop are what eventually close it out if the trend reverses.
# Averaging-in buys never reset the reference price - new tokens just join
# the existing position, they don't restart the cascade.
TAKE_PROFIT_MODE=entry
CASCADE_TAKE_PROFIT_PERCENT=20
CASCADE_TAKE_PROFIT_SELL_PERCENT=20

# --- Strategy: stop loss / trailing stop --------------------------------------
STOP_LOSS_PERCENT=15
TRAILING_STOP_PERCENT=12
# Only start arming the trailing stop once the position is up this much.
TRAILING_STOP_ACTIVATION_PERCENT=0
# Optional: widen the trailing-stop tolerance the higher the position's
# peak gain climbs, so normal volatility near a big pump doesn't shake you
# out early. "gainPercent:trailingStopPercent" pairs, comma separated.
# Empty (default) disables scaling - flat TRAILING_STOP_PERCENT always applies.
TRAILING_STOP_LEVELS=

# --- Wick protection: require the trigger to hold before acting --------------
STOP_CONFIRMATION_ENABLED=true
STOP_CONFIRMATION_MS=2000

# --- On-chain pool watch (optional, OFF by default) ---------------------------
# Watches pool reserve accounts directly over RPC as a fast "something
# moved" trigger, so the bot doesn't have to wait for the next scheduled
# Jupiter poll to notice a sudden move. This NEVER decides a trade by
# itself - every buy/sell is still priced by a real Jupiter quote, this
# only makes the bot check sooner. See README "On-chain pool watch".
ONCHAIN_WATCH_ENABLED=false
ONCHAIN_JUMP_PERCENT=5
ONCHAIN_JUMP_WINDOW_MS=3000
# "label:baseVault:quoteVault" per pool, comma separated. baseVault holds
# the target token's reserve, quoteVault holds SOL's - both are the pool's
# own token accounts, not the token mints.
WATCH_POOLS=

# --- Transaction execution: priority fees / compute budget --------------------
# Jupiter computes the compute unit limit dynamically and caps the priority
# fee at PRIORITY_MAX_LAMPORTS for the chosen PRIORITY_LEVEL (low, medium,
# high, veryHigh). Kept conservative here since trades are ~$1.
PRIORITY_LEVEL=medium
PRIORITY_MAX_LAMPORTS=2000000

# --- Auto-buy (optional, OFF by default) -------------------------------------
# When enabled, the bot buys on its own instead of waiting for a manual
# "buy" command: it watches for price dropping AUTO_BUY_DIP_PERCENT% within
# AUTO_BUY_DIP_LOOKBACK_MS, then buys on the first tick price rebounds from
# its low. This is a heuristic, not a prediction - it will sometimes buy
# into a drop that keeps falling.
AUTO_BUY_ENABLED=false
AUTO_BUY_DIP_PERCENT=50
AUTO_BUY_DIP_LOOKBACK_MS=60000
# By default only buys while flat. true = also buys more while already
# holding a position ("averaging in" on each new qualifying dip) -
# meaningfully more risk, since it can keep buying into a falling token.
AUTO_BUY_ALLOW_AVERAGING=false
# Minimum time between two auto-buys. The low default is a technical safety
# minimum, not a strategy choice - raise it for deliberate spacing.
AUTO_BUY_MIN_GAP_MS=3000
# On by default: a rebound buy only executes if price is below the most
# recent sell's executable price this run - never re-enter worse than
# where you just exited. No effect until at least one sell has happened.
# Only tracks STOP_LOSS/TRAILING_STOP/PANIC_EXIT/MANUAL sells - a
# TAKE_PROFIT sell (either mode) never counts here, since that happens
# because price went UP and would otherwise ratchet this gate up forever.
AUTO_BUY_REQUIRE_BELOW_LAST_SELL=true

# --- Crash-buy (optional, OFF by default) ------------------------------------
# A separate, faster opt-in from AUTO_BUY: watches the live executable USD
# price history for a very sharp, fast drop and buys immediately (no
# dip->rebound wait) - still always through a real Jupiter quote, never a
# raw on-chain swap. Only buys while flat. Sized as a real chunk of the
# wallet on purpose (CRASH_BUY_PORTFOLIO_PERCENT of what's available,
# capped by CRASH_BUY_MAX_USD) since the whole point is catching a rare,
# genuine crash - see README "Crash-buy".
CRASH_BUY_ENABLED=false
CRASH_BUY_DROP_PERCENT=20
CRASH_BUY_WINDOW_MS=1000
CRASH_BUY_MAX_USD=50
CRASH_BUY_PORTFOLIO_PERCENT=50
# Exit rule: sell the whole crash-buy position once price recovers to
# within this tolerance of P0 (the price right before the crash). Until
# then it's protected only by the normal STOP_LOSS_PERCENT/TRAILING_STOP_PERCENT.
CRASH_BUY_REBOUND_TOLERANCE_PERCENT=3
# A genuine crash naturally widens spread - this is deliberately looser
# than everyday trading would tolerate, only meant to reject the extreme
# pathological case (a near-drained/rugged pool), not normal crash
# volatility. In basis points (500 = 5%).
CRASH_BUY_MAX_SPREAD_BPS=500

# --- Storage / logging ---------------------------------------------------------
DB_PATH=./data/cyberleek.sqlite
LOG_LEVEL=info
# The dashboard clears the terminal every second, so this file is where
# warnings/errors actually stick around to be read.
LOG_FILE=./data/bot.log
DASHBOARD_REFRESH_MS=1000
